# Netlify response headers.
# Docs: https://docs.netlify.com/routing/headers/
#
# Cache policy note: none of the assets below are content-hashed (they are
# plain names like images/vintage.jpg), so `immutable` / 1-year caching is
# deliberately NOT used — a swapped photo would never reach returning
# visitors. Durations are short enough that edits go live quickly, with
# stale-while-revalidate covering the refresh in the background.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io

# HTML: always revalidate so content edits are live immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Photography: swapped occasionally, so a week fresh then background refresh.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Stylesheet and script: edited more often than photos.
/style.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/script.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Icons and manifest: effectively static.
/favicon-16.png
  Cache-Control: public, max-age=2592000

/favicon-32.png
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/icon-192.png
  Cache-Control: public, max-age=2592000

/icon-512.png
  Cache-Control: public, max-age=2592000

/site.webmanifest
  Cache-Control: public, max-age=2592000
